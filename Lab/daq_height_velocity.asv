%{
daq_height_velocity.m

Collect Banner sensor data for one trial
Write data to csv
%}

close all
clear all

% turn on ProCoDA Box
daqreset
d = daq("ni");
dio = addoutput(d, 'Dev2', 'port0/line0:7', 'Digital')
enable = [1 1 1 1 1 1 1 1];
write(d, enable)
disp('ProCoDA Box ON')

% add inputs
daqreset
L = daqlist;
disp(strcat("Using ", L.Description))
dq = daq('ni');

ch0 = addinput(dq, "Dev2", 1, "Voltage"); % head tank sensor
ch0.Range = [-10 10];
% ch0.TerminalConfig = "SingleEnded";

ch1 = addinput(dq, "Dev2", 2, "Voltage"); % supercritical sensor
ch1.Range = [-10 10];
% ch1.TerminalConfig = "SingleEnded";

ch2 = addinput(dq, "Dev2", 3, "Voltage"); % subcritical sensor
ch2.Range = [-10 10];
% ch2.TerminalConfig = "SingleEnded";


% collect data
dt_sensor = 0.001; % Sensor sampling rate.
fs = 1/dt_sensor; % daq sampling rate (Hz)
dt = 2; % trial length (s)
dq.Rate = 400;
set(ch0)
set(ch1)
set(ch2)

[data, time, start] = read(dq, seconds(dt), OutputFormat="Matrix");
V_ai0 = data(:,1);
V_ai1 = data(:,2);
V_ai2 = data(:,3);

% plot data
figure()
subplot(311)
plot(time, V_ai0)
xlabel('Time (s)')
ylabel('Voltage (V)')

subplot(312)
plot(time, V_ai1)
xlabel('Time (s)')
ylabel('Voltage (V)')

subplot(313)
plot(time, V_ai2)
xlabel('Time (s)')
ylabel('Voltage (V)')

% write to spreadsheet
%{
tab = table(time, V_ai0, V_ai1, V_ai2);
date = string(datetime('now', 'Format', 'yyyy-MM-dd''_''HH-mm-ss'));
path = "sensor_data\exp1\";
filename = date + "_" + "sensor_data" + ".csv";
writetable(tab, fullfile(path,filename));
%}